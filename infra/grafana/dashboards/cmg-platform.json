{
  "uid": "cmg-platform",
  "title": "Lumen \u2014 Platform Health",
  "tags": [
    "coalminegov"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "cmg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (up)",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cmg-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API requests/s",
      "datasource": {
        "type": "prometheus",
        "uid": "cmg-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cmg_http_requests_total[5m]))",
          "legendFormat": "req/s",
          "datasource": {
            "type": "prometheus",
            "uid": "cmg-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API 5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "cmg-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cmg_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(cmg_http_requests_total[5m])),1)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "cmg-prometheus"
          }
        }
      ]
    },
